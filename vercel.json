{
  "version": 2,
  "builds": [
    {
      "src": "deepseek32-landing.html",
      "use": "@vercel/static"
    },
    {
      "src": "deepseek-v4.html",
      "use": "@vercel/static"
    },
    {
      "src": "deepseek-v3-to-v4-migration.html",
      "use": "@vercel/static"
    },
    {
      "src": "deepseek-v4-vs-gpt5-vs-claude.html",
      "use": "@vercel/static"
    },
    {
      "src": "deepseek-v4-coding-benchmark.html",
      "use": "@vercel/static"
    },
    {
      "src": "deepseek-v4-long-context.html",
      "use": "@vercel/static"
    },
    {
      "src": "remixicon-custom.css",
      "use": "@vercel/static"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/remixicon-custom.css",
      "dest": "/remixicon-custom.css",
      "headers": {
        "Content-Type": "text/css; charset=utf-8",
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/sitemap.xml",
      "dest": "/public/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/robots.txt", 
      "dest": "/public/robots.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/deepseek-v4.html",
      "dest": "/deepseek-v4.html",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/deepseek-v3-to-v4-migration.html",
      "dest": "/deepseek-v3-to-v4-migration.html",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/deepseek-v4-vs-gpt5-vs-claude.html",
      "dest": "/deepseek-v4-vs-gpt5-vs-claude.html",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/deepseek-v4-coding-benchmark.html",
      "dest": "/deepseek-v4-coding-benchmark.html",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/deepseek-v4-long-context.html",
      "dest": "/deepseek-v4-long-context.html",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/deepseek32-landing.html",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    }
  ]
}