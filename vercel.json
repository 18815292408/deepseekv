{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "remixicon-custom.css", "use": "@vercel/static" },
    { "src": "llms.txt", "use": "@vercel/static" },
    { "src": "llms-full.txt", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" },
    { "src": "logo.png", "use": "@vercel/static" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "redirects": [
    { "source": "/deepseek32-landing.html", "destination": "/", "permanent": true },
    { "source": "/affiliate-disclosure.html", "destination": "/advertising-disclosure.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    },
    { "source": "/sitemap.xml", "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
    ]},
    { "source": "/robots.txt", "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
    ]},
    { "source": "/remixicon-custom.css", "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
    ]},
    { "source": "/llms.txt", "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
    ]},
    { "source": "/llms-full.txt", "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
    ]},
    { "source": "/images/(.*)", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
    ]}
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/public/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/public/robots.txt" },
    { "source": "/images/(.*)", "destination": "/public/images/$1" },
    { "source": "/((?!.*\\.xml|.*\\.txt|.*\\.png|.*\\.svg|.*\\.css|.*\\.ico|.*\\.woff2).*)", "destination": "/deepseek32-landing.html" }
  ]
}
