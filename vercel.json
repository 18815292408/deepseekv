{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "remixicon-custom.css", "use": "@vercel/static" },
    { "src": "llms.txt", "use": "@vercel/static" },
    { "src": "llms-full.txt", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" },
    { "src": "logo.png", "use": "@vercel/static" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "comment": "redirect: non-www to www (permanent)",
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "deepseekv.pro" }],
      "status": 308,
      "headers": { "Location": "https://www.deepseekv.pro/$1" }
    },
    {
      "comment": "redirect: landing page to root (permanent)",
      "src": "/deepseek32-landing.html",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "comment": "redirect: old affiliate page to new disclosure page",
      "src": "/affiliate-disclosure.html",
      "status": 308,
      "headers": { "Location": "/advertising-disclosure.html" }
    },
    {
      "comment": "security headers for all requests",
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload"
      },
      "continue": true
    },
    {
      "comment": "cache-control for HTML pages",
      "src": "/(.*\\.html)",
      "headers": { "Cache-Control": "public, max-age=86400" },
      "continue": true
    },
    {
      "comment": "static file routing: sitemap",
      "src": "/sitemap.xml",
      "dest": "/public/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "comment": "static file routing: robots",
      "src": "/robots.txt",
      "dest": "/public/robots.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "comment": "static file routing: images",
      "src": "/images/(.*)",
      "dest": "/public/images/$1",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "comment": "cache-control for CSS",
      "src": "/remixicon-custom.css",
      "headers": {
        "Content-Type": "text/css; charset=utf-8",
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "comment": "cache-control for llms.txt files",
      "src": "/llms.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "/llms-full.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    { "src": "/favicon.svg", "dest": "/favicon.svg" },
    { "src": "/logo.png", "dest": "/logo.png" },
    { "handle": "filesystem" },
    {
      "comment": "catch-all: serve landing page for all unmatched paths",
      "src": "/(.*)",
      "dest": "/deepseek32-landing.html"
    }
  ]
}
